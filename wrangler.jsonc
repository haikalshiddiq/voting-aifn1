{
  "name": "voting-aifn1",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voting-aifn1",
      "database_id": "1f53376a-285a-410a-9372-86fa0e9d5a03",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY":"0x4AAAAAAF9BDxze0hPDiMBA"
  }
}
